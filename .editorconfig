root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,slnx,axaml,json,xml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

# Файлы-образцы 1С не трогаем: кодировка и переводы строк важны для тестов.
[tests/**/Fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Тесты: имена вида Does_something_when_condition и массивы-константы в Assert — принятый стиль xUnit.
[tests/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
