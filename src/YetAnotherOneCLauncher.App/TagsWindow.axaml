<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        xmlns:s="using:YetAnotherOneCLauncher.Core.Settings"
        x:Class="YetAnotherOneCLauncher.App.TagsWindow"
        x:DataType="vm:TagsEditorViewModel"
        Title="Метки"
        Width="620" Height="420" MinWidth="520" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="ErrorText" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="#C42B1C"
                 VerticalAlignment="Center" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button x:Name="OkButton" Classes="accent" Content="OK" IsDefault="True" MinWidth="100" />
        <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" MinWidth="100" />
      </StackPanel>
    </DockPanel>

    <!-- Справа — выбранная метка: наименование, цвет, показ в строках; кнопки «Создать», «Удалить». -->
    <StackPanel DockPanel.Dock="Right" Width="200" Margin="12,0,0,0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="CreateButton" Content="Создать" Command="{Binding CreateCommand}" />
        <Button x:Name="DeleteButton" Content="Удалить" Command="{Binding DeleteCommand}" />
      </StackPanel>
      <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
        <TextBlock Text="Наименование" Margin="0,8,0,0" />
        <TextBox x:Name="NameBox" Text="{Binding SelectedRow.Name, FallbackValue=''}" MaxLength="40" />
        <TextBlock Text="Цвет" />
        <ListBox x:Name="ColorList" ItemsSource="{x:Static vm:TagsEditorViewModel.Colors}"
                 SelectedIndex="{Binding SelectedRow.ColorIndex, FallbackValue=-1}" Background="Transparent">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="5" />
              <Setter Property="MinWidth" Value="0" />
              <Setter Property="CornerRadius" Value="12" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="s:TagColor">
              <Ellipse Classes="tagSwatch" c:TagChip.Color="{Binding}" Width="16" Height="16" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox x:Name="ShowInRowBox" IsChecked="{Binding SelectedRow.ShowInRow, FallbackValue=False}"
                  Content="Показывать в строке списка" />
        <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                   Text="Без этого флажка метка видна только в свойствах базы и в строке отбора." />
      </StackPanel>
    </StackPanel>

    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
      <Panel>
        <TextBlock x:Name="NoTagsText" IsVisible="{Binding !HasRows}" Opacity="0.7" Margin="12" TextWrapping="Wrap"
                   Text="Меток пока нет. Создайте метку здесь или поставьте её базе: контекстное меню → «Метки»." />
        <DockPanel IsVisible="{Binding HasRows}">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,60,80" Margin="12,6" Opacity="0.65">
            <TextBlock Text="Метка" FontSize="12" />
            <TextBlock Grid.Column="1" Text="Баз" FontSize="12" />
            <TextBlock Grid.Column="2" Text="В строке" FontSize="12" />
          </Grid>
          <ListBox x:Name="TagsList" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TagRowViewModel">
                <Grid ColumnDefinitions="*,60,80">
                  <Border Classes="tagChip" c:TagChip.Color="{Binding Color}" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  </Border>
                  <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="✓" IsVisible="{Binding ShowInRow}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Panel>
    </Border>
  </DockPanel>
</Window>
