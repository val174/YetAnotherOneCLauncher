<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        x:Class="YetAnotherOneCLauncher.App.CacheManagerWindow"
        x:DataType="vm:CacheManagerViewModel"
        Title="Кэш баз"
        Width="820" Height="560" MinWidth="560" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>
    <Style Selector="Path.icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.3" />
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
    </Style>
    <Style Selector="TextBlock.orphan">
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="TextBlock.size">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding TotalText}" TextWrapping="Wrap" />
      <TextBlock Classes="secondary" TextWrapping="Wrap"
                 Text="Кэш удаляется насовсем, без корзины; 1С заполнит его заново при следующем запуске базы. «Нет в списках баз» — кэш удалённых баз, которых больше нет ни в одном списке." />
      <DockPanel>
        <!-- Справа: выбор кэша удалённых баз и пересчёт — значок и текст. -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="SelectOrphansButton" Command="{Binding SelectOrphansCommand}"
                  ToolTip.Tip="Выбрать кэш баз, которых больше нет ни в одном списке">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- База (цилиндр) с крестиком. -->
              <Path Classes="icon" Data="M 1.5,4 A 5.5,2 0 1 0 12.5,4 A 5.5,2 0 1 0 1.5,4 M 1.5,4 L 1.5,12 A 5.5,2 0 0 0 8.5,13.8 M 12.5,4 L 12.5,8.5 M 10.2,10.2 L 14.8,14.8 M 14.8,10.2 L 10.2,14.8" />
              <TextBlock Text="Удаленные базы" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="RefreshButton" Command="{Binding RefreshCommand}" ToolTip.Tip="Пересчитать размеры кэша">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Path Classes="icon" Data="M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12.4,1.2 L 12.4,4.6 L 9,4.6" />
              <TextBlock Text="Пересчитать" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
        <!-- Слева: выбрать все и снять выбор — значками. -->
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button x:Name="SelectAllButton" Command="{Binding SelectAllCommand}" ToolTip.Tip="Выбрать все" VerticalAlignment="Stretch">
            <Path Classes="icon" Data="M 1.5,1.5 L 14.5,1.5 L 14.5,14.5 L 1.5,14.5 Z M 4.5,8.2 L 7,10.7 L 11.5,5.5" />
          </Button>
          <Button x:Name="SelectNoneButton" Command="{Binding SelectNoneCommand}" ToolTip.Tip="Снять выбор" VerticalAlignment="Stretch">
            <Path Classes="icon" Data="M 1.5,1.5 L 14.5,1.5 L 14.5,14.5 L 1.5,14.5 Z" />
          </Button>
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <CheckBox IsChecked="{Binding IncludeRoaming}" IsVisible="{Binding HasRoaming}"
                Content="Удалять и локальные настройки пользователя (Roaming)" />
      <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <Button x:Name="CleanButton" Classes="accent" Content="Очистить" Command="{Binding CleanCommand}" MinWidth="110" />
          <Button x:Name="CloseButton" Content="Закрыть" IsCancel="True" MinWidth="100" />
        </StackPanel>
        <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" />
      </DockPanel>
    </StackPanel>

    <Grid ColumnDefinitions="32,*,110,110,90" DockPanel.Dock="Top" Margin="12,0,12,4">
      <TextBlock Grid.Column="1" Classes="secondary" Text="База" />
      <TextBlock Grid.Column="2" Classes="secondary size" Text="Кэш" />
      <TextBlock Grid.Column="3" Classes="secondary size" Text="Настройки" IsVisible="{Binding HasRoaming}" />
      <TextBlock Grid.Column="4" Classes="secondary size" Text="Изменён" />
    </Grid>

    <ListBox x:Name="RowsList" ItemsSource="{Binding Rows}" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:CacheRowViewModel">
          <Grid ColumnDefinitions="32,*,110,110,90" Background="Transparent">
            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Name}" Classes.orphan="{Binding IsOrphan}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="secondary" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="2" Classes="size" Text="{Binding LocalText}" />
            <TextBlock Grid.Column="3" Classes="size" Text="{Binding RoamingText}" />
            <TextBlock Grid.Column="4" Classes="size" Text="{Binding LastWriteText}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
