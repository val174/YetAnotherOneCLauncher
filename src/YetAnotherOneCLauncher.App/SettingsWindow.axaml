<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        xmlns:app="using:YetAnotherOneCLauncher.App"
        xmlns:svc="using:YetAnotherOneCLauncher.App.Services"
        x:Class="YetAnotherOneCLauncher.App.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{Binding Title}"
        Width="1040" Height="740" MinWidth="800" MinHeight="440"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <!-- Оттенок в списке: образец цвета фона и название. -->
    <DataTemplate x:Key="ShadeItemTemplate" x:DataType="svc:ShadePalette">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="16" Height="16" CornerRadius="3" Background="{Binding RegionBrush}" BorderBrush="#80808080" BorderThickness="1"
                VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
    <!-- Превью: окно лаунчера в оттенке — его цветами, независимо от текущей темы. -->
    <DataTemplate x:Key="ShadePreviewTemplate" x:DataType="svc:ShadePalette">
      <Border Classes="shadePreview" CornerRadius="6" BorderThickness="1" ClipToBounds="True"
              Background="{Binding RegionBrush}" BorderBrush="{Binding BorderBrush}" TextElement.Foreground="{Binding TextBrush}" TextElement.FontSize="11">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Background="{Binding HeaderBrush}">
            <TextBlock Text="Наименование" Opacity="0.65" Margin="8,3" />
            <TextBlock Grid.Column="1" Text="Платформа" Opacity="0.65" Margin="8,3" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Бухгалтерия" Margin="8,4" />
            <TextBlock Grid.Column="1" Text="8.3.27" Margin="8,4" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Background="{Binding StripeBrush}">
            <TextBlock Text="Зарплата и кадры" Margin="8,4" />
            <TextBlock Grid.Column="1" Text="8.5.1" Margin="8,4" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto" Background="{Binding SelectionBrush}">
            <TextBlock Text="Розница" Margin="8,4" />
            <TextBlock Grid.Column="1" Text="8.3.27" Margin="8,4" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="8">
            <Border CornerRadius="4" Background="#0078D4" Padding="8,3">
              <TextBlock Text="▶ 1С: Предприятие" Foreground="White" />
            </Border>
            <Border CornerRadius="4" Background="{Binding ButtonBrush}" Padding="8,3">
              <TextBlock Text="Конфигуратор" />
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C42B1C" />
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Вкладки слева: во всю ширину колонки, текст слева. -->
    <Style Selector="TabControl#Tabs /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Width" Value="260" />
    </Style>
    <Style Selector="TabControl#Tabs > TabItem">
      <Setter Property="FontSize" Value="{StaticResource AppFontSize}" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.hotKey">
      <Setter Property="MinWidth" Value="170" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace" />
    </Style>
    <Style Selector="Button.rowIcon">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.hotKey.capturing">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="12">
    <!-- Кнопки окна. -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <Button x:Name="AboutButton" Content="О программе…" Command="{Binding ShowAboutCommand}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button x:Name="SaveButton" Content="Сохранить" Classes="accent" IsEnabled="{Binding IsDirty}"
                MinWidth="110" HorizontalContentAlignment="Center" />
        <Button x:Name="CancelButton" Content="Отменить" IsCancel="True" MinWidth="110" HorizontalContentAlignment="Center" />
      </StackPanel>
    </Grid>

    <TabControl x:Name="Tabs" TabStripPlacement="Left" Padding="16,0,0,0">
      <!-- Общие: поведение лаунчера. -->
      <TabItem x:Name="GeneralTab" Header="{Binding GeneralHeader}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="0,0,12,0">
            <TextBlock Classes="fieldLabel" Text="После запуска базы" Margin="0,4,0,4" />
            <ComboBox x:Name="AfterLaunchBox" ItemsSource="{Binding AfterLaunchNames}" SelectedIndex="{Binding AfterLaunchIndex}"
                      HorizontalAlignment="Stretch" />
            <CheckBox x:Name="MinimizeToTrayBox" IsChecked="{Binding MinimizeToTray}" Content="Сворачивать в трей" Margin="0,10,0,0" />
            <CheckBox x:Name="SingleInstanceBox" IsChecked="{Binding SingleInstance}" Content="Запретить повторный запуск" />
            <TextBlock Classes="secondary" Margin="28,0,0,0" Text="Действует со следующего запуска лаунчера." />
            <CheckBox IsChecked="{Binding UseThickClientForFileBases}" Margin="0,6,0,0">
              <TextBlock TextWrapping="Wrap" Text="Файловые базы с клиентом «Автоматически» открывать в толстом клиенте" />
            </CheckBox>
            <CheckBox x:Name="CheckAvailabilityBox" IsChecked="{Binding CheckAvailability}">
              <TextBlock TextWrapping="Wrap" Text="Проверять доступность баз: каталог файловой базы, сервер 1С, веб-сервер" />
            </CheckBox>
            <CheckBox x:Name="ShowEdtProjectsBox" IsChecked="{Binding ShowEdtProjects}">
              <TextBlock TextWrapping="Wrap" Text="Использовать проекты 1C:EDT (из 1C:EDT Start): группа в списке, поиск, режим «Проекты 1C:EDT», кнопки 1C:EDT у баз" />
            </CheckBox>

            <!-- Обновление лаунчера из релизов GitHub (ветка main). -->
            <TextBlock Classes="fieldLabel" Text="Обновление" Margin="0,16,0,4" />
            <ComboBox x:Name="UpdateModeBox" ItemsSource="{Binding UpdateModeNames}" SelectedIndex="{Binding UpdateModeIndex}"
                      HorizontalAlignment="Stretch" />
            <TextBlock Classes="secondary" Text="{Binding UpdateModeHint}" TextWrapping="Wrap" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0" IsVisible="{Binding CheckForUpdatesCommand, Converter={x:Static ObjectConverters.IsNotNull}}">
              <Button x:Name="CheckForUpdatesButton" Content="Проверить обновления" Command="{Binding CheckForUpdatesCommand}" />
              <TextBlock Classes="secondary" Text="{Binding UpdateStatusText}" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Внешний вид. -->
      <TabItem x:Name="AppearanceTab" Header="{Binding AppearanceHeader}">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,8">
          <!-- Тема и стиль значков — в одну строку. -->
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Text="Тема" Margin="0,4,0,4" />
              <ComboBox x:Name="ThemeBox" ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="fieldLabel" Text="Стиль значков" Margin="0,4,0,4" />
              <ComboBox x:Name="IconStyleBox" ItemsSource="{Binding IconStyleNames}" SelectedIndex="{Binding IconStyleIndex}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
          <!-- Оттенки тем: слева — светлой, справа — тёмной; под каждым — как выглядит окно. -->
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel>
              <TextBlock Classes="fieldLabel" Text="Оттенок светлой темы" />
              <ComboBox x:Name="LightShadeBox" ItemsSource="{Binding LightShadeChoices}" SelectedIndex="{Binding LightShadeIndex}"
                        HorizontalAlignment="Stretch" ItemTemplate="{StaticResource ShadeItemTemplate}"
                        ToolTip.Tip="Фон окон и панелей в светлой теме (поля остаются белыми). Применяется сразу после «Сохранить»." />
              <ContentControl x:Name="LightShadePreview" Content="{Binding LightShadePreview}" ContentTemplate="{StaticResource ShadePreviewTemplate}"
                              Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Classes="fieldLabel" Text="Оттенок тёмной темы" />
              <ComboBox x:Name="DarkShadeBox" ItemsSource="{Binding DarkShadeChoices}" SelectedIndex="{Binding DarkShadeIndex}"
                        HorizontalAlignment="Stretch" ItemTemplate="{StaticResource ShadeItemTemplate}"
                        ToolTip.Tip="Фон окон и полей в тёмной теме. Применяется сразу после «Сохранить»." />
              <ContentControl x:Name="DarkShadePreview" Content="{Binding DarkShadePreview}" ContentTemplate="{StaticResource ShadePreviewTemplate}"
                              Margin="0,8,0,0" />
            </StackPanel>
          </Grid>
          <CheckBox x:Name="ShowDetailsBox" IsChecked="{Binding ShowDetails}" Content="Показывать свойства информационной базы"
                    Margin="0,12,0,0" />
          <CheckBox x:Name="ShowSideLaunchButtonsBox" IsChecked="{Binding ShowSideLaunchButtons}"
                    Content="Кнопки запуска 1С справа от списка баз" />
          <CheckBox x:Name="ShowRowLaunchButtonsBox" IsChecked="{Binding ShowRowLaunchButtons}"
                    Content="Кнопки запуска 1С в строках списка баз" />
          <StackPanel Margin="28,2,0,0" Spacing="4" IsEnabled="{Binding ShowRowLaunchButtons}">
            <ComboBox x:Name="RowLaunchPlacementBox" ItemsSource="{Binding RowLaunchPlacementNames}"
                      SelectedIndex="{Binding RowLaunchPlacementIndex}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Где в строке стоят кнопки запуска" />
            <TextBlock Classes="secondary" Text="{Binding RowLaunchHint}" />
          </StackPanel>
          <CheckBox x:Name="HighlightRunningBox" IsChecked="{Binding HighlightRunning}" Margin="0,6,0,0"
                    Content="Подсвечивать запущенные базы" />
          <TextBlock Classes="secondary" Margin="28,0,0,0"
                     Text="Зелёная точка справа от наименования у баз, открытых в 1С: из лаунчера, стартером 1С или ярлыком." />
          <CheckBox x:Name="TwoLineRowsBox" IsChecked="{Binding TwoLineRows}" Margin="0,6,0,0"
                    Content="Список баз в две строки" />
          <TextBlock Classes="secondary" Margin="28,0,0,0"
                     Text="В первой строке — наименование базы и кнопки запуска, во второй — платформа, режим запуска и последний запуск." />
          <TextBlock Classes="fieldLabel" Text="Чередование цвета строк" />
          <ComboBox x:Name="RowStripesBox" ItemsSource="{Binding RowStripesNames}" SelectedIndex="{Binding RowStripesIndex}"
                    HorizontalAlignment="Stretch" ToolTip.Tip="Каждая вторая строка списка баз — на лёгкой подложке" />
        </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Горячие клавиши. -->
      <TabItem x:Name="HotKeysTab" Header="{Binding HotKeysHeader}">
        <DockPanel Margin="0,0,4,0">
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,10,8,0">
            <TextBlock Classes="secondary" VerticalAlignment="Center"
                       Text="Всегда работают: Enter и двойной щелчок — запуск, Esc — очистить поиск, Ins в списке — новая база." />
            <Button x:Name="ResetAllHotKeysButton" Grid.Column="1" Content="Всё по умолчанию" Command="{Binding ResetAllHotKeysCommand}"
                    Margin="12,0,0,0" />
          </Grid>
          <TextBlock DockPanel.Dock="Top" Classes="secondary" Margin="0,4,0,8"
                     Text="Щёлкните сочетание и нажмите новое. Esc — отменить ввод." />
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="HotKeyList" ItemsSource="{Binding HotKeyRows}" Margin="0,0,12,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:HotKeyRowViewModel">
                  <StackPanel Margin="0,0,0,6">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Classes="hotKey" Classes.capturing="{Binding IsCapturing}" Content="{Binding GestureText}"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).StartCaptureCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Щёлкните и нажмите новое сочетание" />
                      <Button Grid.Column="2" Classes="rowIcon" Margin="6,0,0,0" IsEnabled="{Binding !IsDefault}"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ResetHotKeyCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="{Binding DefaultText}">
                        <!-- Стрелка по кругу: вернуть по умолчанию. -->
                        <c:ToolIcon Classes="buttonIcon" Data="M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12.4,1.2 L 12.4,4.6 L 9,4.6" />
                      </Button>
                      <Button Grid.Column="3" Classes="rowIcon" Margin="6,0,0,0"
                              Command="{Binding $parent[Window].((vm:SettingsViewModel)DataContext).ClearHotKeyCommand}"
                              CommandParameter="{Binding}" ToolTip.Tip="Снять сочетание">
                        <c:ToolIcon Classes="buttonIcon" Data="M 4,4 L 12,12 M 12,4 L 4,12" />
                      </Button>
                    </Grid>
                    <TextBlock Classes="error" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" HorizontalAlignment="Right" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Шаблоны параметров: встроенные и свои; сохраняются вместе с остальными настройками. -->
      <TabItem x:Name="TemplatesTab" Header="{Binding TemplatesHeader}">
        <app:ParameterTemplatesView x:Name="TemplatesView" DataContext="{Binding Templates}" Margin="0,4,4,0" />
      </TabItem>

      <!-- Средства администрирования: таблица «Инструменты» — веб-сервисы и программы со значками. -->
      <TabItem x:Name="AdminToolsTab" Header="{Binding AdminToolsHeader}">
        <app:AdminToolsView x:Name="AdminToolsView" DataContext="{Binding AdminTools}" Margin="0,4,4,0" />
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
