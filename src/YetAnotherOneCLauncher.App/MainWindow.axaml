<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="YetAnotherOneCLauncher.App.MainWindow"
        Title="YetAnotherOneCLauncher"
        Width="900" Height="600"
        MinWidth="500" MinHeight="300">
  <!-- Временное окно для проверки чтения списков на реальных машинах. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="ReloadButton" Content="Обновить" />
        <ComboBox x:Name="ThemeBox" Width="170" />
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <Expander x:Name="WarningsExpander"
              DockPanel.Dock="Bottom"
              Header="Предупреждения"
              HorizontalAlignment="Stretch"
              IsVisible="False">
      <ScrollViewer MaxHeight="180">
        <SelectableTextBlock x:Name="WarningsText" TextWrapping="Wrap" />
      </ScrollViewer>
    </Expander>

    <TreeView x:Name="CatalogTree" Margin="8,0,8,8" />
  </DockPanel>
</Window>
