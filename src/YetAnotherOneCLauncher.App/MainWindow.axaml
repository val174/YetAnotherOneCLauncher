<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        x:Class="YetAnotherOneCLauncher.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="YetAnotherOneCLauncher"
        Width="1040" Height="660"
        MinWidth="600" MinHeight="360"
        c:ToolIcon.IconStyle="{Binding IconStyle}"
        Classes.flatToolbar="{Binding IsFlatToolbar}"
        Classes.flatButtons="{Binding IsFlatToolbar}">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,12,6" />
    </Style>
    <!-- Разделитель групп свойств базы. -->
    <Style Selector="Border.propertiesSeparator">
      <Setter Property="Height" Value="1" />
      <Setter Property="Margin" Value="0,4,0,10" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <!-- Маленькие кнопки-значки в панели подробностей. -->
    <Style Selector="Button.icon">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <!-- Кнопки запуска: основная часть на всю ширину и прикреплённая справа «Запустить с параметрами» — одним блоком. -->
    <Style Selector="Button.launchMain">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="CornerRadius" Value="4,0,0,4" />
    </Style>
    <Style Selector="Button.launchParameters">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="1,0,0,0" />
      <Setter Property="CornerRadius" Value="0,4,4,0" />
    </Style>
    <!-- Заголовок раздела правой панели. -->
    <Style Selector="TextBlock.sectionHeader">
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- Значок пункта меню. -->
    <Style Selector="c|ToolIcon.menuIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
    </Style>
    <!-- Кнопка-значок в строке состояния: без фона, ниже кнопок панели подробностей. -->
    <Style Selector="Button.statusIcon">
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Цветные значки (docs/ICON-VARIANTS.md): у недоступной кнопки значок бледнеет —
         цвет значка от состояния кнопки не зависит. -->
    <Style Selector="StackPanel#ToolbarButtons Button:disabled c|ToolIcon, Button.icon:disabled c|ToolIcon, Button.statusIcon:disabled c|ToolIcon">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <!-- Звезда избранной базы в строке списка: чуть меньше значков папок. -->
    <Style Selector="c|ToolIcon.favStar">
      <Setter Property="Width" Value="15" />
      <Setter Property="Height" Value="15" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Brush" Value="{DynamicResource IconFavoriteBrush}" />
      <Setter Property="Data" Value="M 8,1.6 L 9.71,6.05 L 14.47,6.3 L 10.76,9.3 L 12,13.9 L 8,11.3 L 4,13.9 L 5.24,9.3 L 1.53,6.3 L 6.29,6.05 Z" />
    </Style>
    <!-- Колонки списка баз. -->
    <Style Selector="Grid#ColumnHeaders">
      <Setter Property="Margin" Value="12,6,12,6" />
    </Style>
    <!-- У строк дерева отступ справа меньше, чем у строк списка. -->
    <Style Selector="Grid#ColumnHeaders.tree">
      <Setter Property="Margin" Value="12,6,1,6" />
    </Style>
    <Style Selector="TextBlock.cell">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="TextBlock.platform">
      <Setter Property="Width" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).PlatformColumnWidth}" />
    </Style>
    <Style Selector="TextBlock.mode">
      <Setter Property="Width" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ModeColumnWidth}" />
    </Style>
    <Style Selector="TextBlock.date">
      <Setter Property="Width" Value="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LastLaunchColumnWidth}" />
    </Style>
    <!-- Граница колонки в заголовке: тянуть — ширина колонки справа от неё, двойной щелчок — ширина по умолчанию. -->
    <Style Selector="Border.columnGrip">
      <Setter Property="Width" Value="9" />
      <Setter Property="Margin" Value="-4,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="Border.columnGrip > Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="Grid#ColumnHeaders:pointerover Border.columnGrip > Border">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Наименование и зелёная точка запущенной базы сразу за ним: колонка имени — «*» в сетке, прижатой влево, —
         по ширине текста, а при нехватке места имя обрезается, точка остаётся видна. -->
    <Style Selector="Grid.nameWithDot">
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style Selector="Ellipse.runningDot">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="#2EA043" />
    </Style>
    <Style Selector="TextBlock.missing">
      <Setter Property="Foreground" Value="#C57C00" />
    </Style>
    <!-- Список в две строки (настройка «Внешний вид»): колонок нет — платформа, режим запуска и последний запуск
         во второй строке, под наименованием и кнопками запуска. -->
    <Style Selector="Grid#ColumnHeaders.twoLine > TextBlock.cell, Grid#ColumnHeaders.twoLine > Border.columnGrip, Grid.baseRow.twoLine > TextBlock.cell">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="StackPanel.rowDetails">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,1,0,0" />
    </Style>
    <Style Selector="Grid.baseRow.twoLine > StackPanel.rowDetails">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Кнопки запуска в строке базы — в колонке наименования, у её правого края: видны у строки под указателем
         и у выделенной (имя на это время обрезается перед ними). Выделенная строка дерева — та, чей TreeViewItem
         выделен сам (не папка выше). -->
    <!-- Кнопки (22 пкс) выше строки текста: отрицательные отступы сверху и снизу — кнопки заходят в поля строки
         и не меняют её высоту, иначе при наведении строки ниже сдвигаются. -->
    <!-- Место (справа или слева от наименования) — стилем, не в разметке: локальное значение стиль не переопределит. -->
    <Style Selector="Panel.rowLaunchCell">
      <Setter Property="DockPanel.Dock" Value="Right" />
      <Setter Property="Margin" Value="4,-4,8,-4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.rowLaunch">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.baseRow:pointerover StackPanel.rowLaunch">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBoxItem:selected StackPanel.rowLaunch">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TreeViewItem:selected > Grid.baseRow StackPanel.rowLaunch">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <!-- Слева от наименования (настройка): одна кнопка ▶ в каждой строке, видна всегда; щелчок открывает меню режимов
         запуска (MainWindow.axaml.cs) — сам по себе базу не запускает. Три кнопки справа в этом режиме не показываются. -->
    <Style Selector="Button.rowLaunchMenu">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.baseRow.launchLeft Panel.rowLaunchCell">
      <Setter Property="DockPanel.Dock" Value="Left" />
      <Setter Property="Margin" Value="-4,-4,4,-4" />
    </Style>
    <Style Selector="Grid.baseRow.launchLeft StackPanel.rowLaunch">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Grid.baseRow.launchLeft Button.rowLaunchMenu">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.rowLaunch">
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rowLaunch c|ToolIcon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="StrokeThickness" Value="1.8" />
    </Style>
    <Style Selector="Button.rowLaunch.enterprise c|ToolIcon">
      <Setter Property="Brush" Value="{DynamicResource IconViewBrush}" />
    </Style>
    <Style Selector="Button.rowLaunch.designer c|ToolIcon">
      <Setter Property="Brush" Value="{DynamicResource IconCopyBrush}" />
    </Style>
    <Style Selector="Button.rowLaunch.parameters c|ToolIcon">
      <Setter Property="Brush" Value="{DynamicResource IconSettingsBrush}" />
    </Style>
    <!-- На фоне выделения цветной значок теряется — в выделенной строке он цвета её текста. -->
    <Style Selector="ListBoxItem:selected Button.rowLaunch c|ToolIcon, TreeViewItem:selected > Grid.baseRow Button.rowLaunch c|ToolIcon">
      <Setter Property="Brush" Value="{x:Null}" />
    </Style>
    <!-- Заголовок «Наименование» — кнопка без рамки и фона, выглядит как остальные заголовки. -->
    <Style Selector="Button.columnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Button.columnHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.columnHeader:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.columnHeader:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.columnHeader">
      <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="Button.columnHeader:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Переключатель режимов: сегменты в общей рамке, выбранный подсвечен. -->
    <Style Selector="Border.segmented">
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- Кнопки панели главного окна («Стиль 1», «Стиль 2»): обычные кнопки с заливкой; черты между группами и плашки
         тумблера нет. Внутренние отступы — стилем, а не в разметке кнопок: «Стиль 3» их меняет. -->
    <Style Selector="StackPanel#ToolbarButtons > Button">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Panel.toolbarGlyph">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Border.toolbarSeparator">
      <Setter Property="IsVisible" Value="False" />
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
    </Style>
    <Style Selector="Border.switchThumb">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- «Стиль 3» (класс flatToolbar у окна): плоские кнопки 40×40 без фона — фон при наведении и нажатии, значки 26 px,
         группы разделены чертой; «Все базы / Недавние / Избранное» — тумблер: дорожка и плашка, которая переезжает
         под выбранный режим. -->
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons">
      <Setter Property="Spacing" Value="1" />
    </Style>
    <Style Selector="Window.flatToolbar Border.toolbarSeparator">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FlatButtonHoverBrush}" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource FlatButtonPressedBrush}" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#ToolbarButtons > Button > c|ToolIcon, Window.flatToolbar Panel.toolbarGlyph">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="Window.flatToolbar Border.segmented">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource FlatSwitchTrackBrush}" />
      <Setter Property="CornerRadius" Value="21" />
      <Setter Property="Padding" Value="2" />
      <Setter Property="ClipToBounds" Value="False" />
    </Style>
    <Style Selector="Window.flatToolbar Border.switchThumb">
      <Setter Property="IsVisible" Value="True" />
      <Setter Property="Width" Value="48" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="Background" Value="{DynamicResource FlatSwitchThumbBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource FlatSwitchThumbBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Window.flatToolbar RadioButton.segment">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="19" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Window.flatToolbar RadioButton.segment /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Window.flatToolbar RadioButton.segment > c|ToolIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Window.flatToolbar RadioButton.segment:pointerover > c|ToolIcon">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Window.flatToolbar RadioButton.segment:checked > c|ToolIcon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="TextBlock.columnHeader">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="{StaticResource SmallFontSize}" />
    </Style>
    <!-- Отдельная кнопка запуска (стартер 1С) — скруглена со всех сторон. -->
    <Style Selector="Button.launchMain.single">
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <!-- «Стиль 3»: кнопки запуска справа выше, скругление 6 (у пары «запуск + с параметрами» — по внешним углам), значки 18;
         кнопки-значки в строках списка и в свойствах базы — скругление 6, значки крупнее. -->
    <Style Selector="Window.flatToolbar Button.launchMain">
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="CornerRadius" Value="6,0,0,6" />
    </Style>
    <Style Selector="Window.flatToolbar Button.launchMain.single">
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Window.flatToolbar Button.launchParameters">
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CornerRadius" Value="0,6,6,0" />
    </Style>
    <Style Selector="Window.flatToolbar StackPanel#LaunchButtons c|ToolIcon.buttonIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Window.flatToolbar Button.rowLaunch">
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Window.flatToolbar Button.rowLaunch c|ToolIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Window.flatToolbar Button.icon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Window.flatToolbar Button.icon c|ToolIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <!-- Строка заголовков колонок списка баз — на лёгком фоне. -->
    <Style Selector="Border#ColumnHeadersBand">
      <Setter Property="Background" Value="{DynamicResource ListHeaderBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Верх: кнопки слева над списком баз, поле поиска справа — над панелью подробностей и её ширины (задаётся в коде). -->
    <DockPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Margin="8,8,12,4" LastChildFill="True">
      <Panel x:Name="ToolbarPanel" DockPanel.Dock="Left" Margin="0,0,6,0">
      <StackPanel x:Name="ToolbarButtons" Orientation="Horizontal" Spacing="6">
        <!-- Значок текущего вида: иерархия — дерево папок, строки — плоский список. -->
        <Button x:Name="ViewModeButton" Command="{Binding ToggleViewModeCommand}">
          <Panel Classes="toolbarGlyph">
            <c:ToolIcon IsVisible="{Binding IsTreeMode}" StrokeThickness="1.5" Brush="{DynamicResource IconViewBrush}"
                        Data="M 1,2.5 L 11,2.5 M 3,2.5 L 3,13 M 3,7.75 L 6,7.75 M 3,13 L 6,13 M 8,7.75 L 15,7.75 M 8,13 L 15,13" />
            <c:ToolIcon IsVisible="{Binding !IsTreeMode}" StrokeThickness="1.5" Brush="{DynamicResource IconViewBrush}"
                        Data="M 5,3 L 15,3 M 5,8 L 15,8 M 5,13 L 15,13 M 1,3 L 2.6,3 M 1,8 L 2.6,8 M 1,13 L 2.6,13" />
          </Panel>
          <ToolTip.Tip>
            <Panel>
              <TextBlock Text="Показано деревом папок. Нажмите для плоского списка" IsVisible="{Binding IsTreeMode}" />
              <TextBlock Text="Показан плоский список. Нажмите для дерева папок" IsVisible="{Binding !IsTreeMode}" />
            </Panel>
          </ToolTip.Tip>
        </Button>
        <!-- Только для дерева: «Развернуть все» — стопка папок с минусом, «Свернуть все» — с плюсом.
             В списке и при поиске недоступны (видны бледными) — остальные кнопки не сдвигаются. -->
        <Button x:Name="ExpandAllButton" Command="{Binding ExpandAllCommand}" IsEnabled="{Binding ShowTree}"
                ToolTip.Tip="Развернуть все папки">
          <c:ToolIcon Brush="{DynamicResource IconFolderBrush}"
                      Data="M 4.5,1.5 L 14.5,1.5 L 14.5,11.5 M 1.5,4.5 L 11.5,4.5 L 11.5,14.5 L 1.5,14.5 Z M 4,9.5 L 9,9.5" />
        </Button>
        <Button x:Name="CollapseAllButton" Command="{Binding CollapseAllCommand}" IsEnabled="{Binding ShowTree}"
                ToolTip.Tip="Свернуть все папки">
          <c:ToolIcon Brush="{DynamicResource IconFolderBrush}"
                      Data="M 4.5,1.5 L 14.5,1.5 L 14.5,11.5 M 1.5,4.5 L 11.5,4.5 L 11.5,14.5 L 1.5,14.5 Z M 4,9.5 L 9,9.5 M 6.5,7 L 6.5,12" />
        </Button>
        <Border Classes="toolbarSeparator" />
        <Button x:Name="AddButton" ToolTip.Tip="Добавить" IsEnabled="{Binding CanEditList}">
          <c:ToolIcon StrokeThickness="1.5" Brush="{DynamicResource IconAddBrush}" Data="M 8,2 L 8,14 M 2,8 L 14,8" />
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Новая база…" Command="{Binding AddBaseCommand}" InputGesture="{Binding HotKeys.AddBase}">
                <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconAddBrush}" Data="{StaticResource AddIconGeometry}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Новая папка…" Command="{Binding AddFolderCommand}" InputGesture="{Binding HotKeys.AddFolder}">
                <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconFolderBrush}" Data="{StaticResource FolderIconGeometry}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Загрузить из файла .v8i…" Command="{Binding ImportCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <!-- Карандаш: та же команда, что «Изменить…» в контекстном меню и F2. -->
        <Button x:Name="EditButton" Command="{Binding EditCommand}"
                ToolTip.Tip="{Binding HotKeys.EditSuffix, StringFormat='Изменить базу или переименовать папку{0}'}">
          <c:ToolIcon Brush="{DynamicResource IconSettingsBrush}" Data="{StaticResource EditIconGeometry}" />
        </Button>
        <!-- Корзина: та же команда, что «Удалить» в контекстном меню и Del. -->
        <Button x:Name="DeleteButton" Command="{Binding DeleteCommand}"
                ToolTip.Tip="{Binding HotKeys.DeleteSuffix, StringFormat='Удалить из списка{0}'}">
          <c:ToolIcon Brush="{DynamicResource IconDeleteBrush}"
                      Data="M 2,4 L 14,4 M 6,4 L 6,1.8 L 10,1.8 L 10,4 M 3.6,4 L 4.5,14.5 L 11.5,14.5 L 12.4,4 M 6.5,6.8 L 6.5,12 M 9.5,6.8 L 9.5,12" />
        </Button>
        <Border Classes="toolbarSeparator" />
        <!-- Что показать — переключатель: все базы, недавние, избранное; выбранное положение подсвечено. -->
        <Border x:Name="ListFilterSwitch" Classes="segmented" VerticalAlignment="Stretch">
          <!-- Выбранный сегмент — лёгкая заливка цветом акцента, текст и значки — обычного цвета (в обеих темах). -->
          <Border.Resources>
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{DynamicResource SystemAccentColor}" Opacity="0.3" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{DynamicResource SystemAccentColor}" Opacity="0.4" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{DynamicResource SystemAccentColor}" Opacity="0.5" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="Transparent" />
          </Border.Resources>
          <Panel>
            <!-- «Стиль 3»: плашка под выбранным режимом — переезжает при переключении (тумблер). -->
            <Border x:Name="ListFilterThumb" Classes="switchThumb" Margin="{Binding ListFilter, Converter={x:Static c:ToolbarConverters.SwitchThumbOffset}}" />
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="AllBasesButton" Classes="segment" Theme="{StaticResource {x:Type ToggleButton}}" GroupName="ListFilter" IsChecked="{Binding IsAllBasesMode}"
                         ToolTip.Tip="Все базы">
              <c:ToolIcon Brush="{DynamicResource IconAllBasesBrush}"
                          Data="M 2.5,3.5 A 5.5,2 0 1 0 13.5,3.5 A 5.5,2 0 1 0 2.5,3.5 M 2.5,3.5 L 2.5,12.5 A 5.5,2 0 0 0 13.5,12.5 L 13.5,3.5 M 2.5,8 A 5.5,2 0 0 0 13.5,8" />
            </RadioButton>
            <RadioButton x:Name="RecentButton" Classes="segment" Theme="{StaticResource {x:Type ToggleButton}}" GroupName="ListFilter" IsChecked="{Binding IsRecentMode}"
                         ToolTip.Tip="Недавние базы: последние запуски, свежие сверху">
              <c:ToolIcon Brush="{DynamicResource IconRecentBrush}"
                          Data="M 8,1.8 A 6.2,6.2 0 1 1 7.99,1.8 Z M 8,4.6 L 8,8 L 10.6,9.6" />
            </RadioButton>
            <RadioButton x:Name="FavoritesButton" Classes="segment" Theme="{StaticResource {x:Type ToggleButton}}" GroupName="ListFilter" IsChecked="{Binding IsFavoritesMode}"
                         ToolTip.Tip="Избранные базы">
              <c:ToolIcon Brush="{DynamicResource IconFavoriteBrush}" Data="{StaticResource StarIconGeometry}" />
            </RadioButton>
          </StackPanel>
          </Panel>
        </Border>
        <Border Classes="toolbarSeparator" />
        <Button x:Name="ReloadButton" Command="{Binding ReloadCommand}"
                ToolTip.Tip="{Binding HotKeys.ReloadSuffix, StringFormat='Обновить: перечитать списки баз и платформы{0}'}">
          <c:ToolIcon StrokeThickness="1.4" Brush="{DynamicResource IconRefreshBrush}"
                      Data="M 13.5,8 A 5.5,5.5 0 1 1 11.9,4.1 M 12.4,1.2 L 12.4,4.6 L 9,4.6" />
        </Button>
        <Button x:Name="ClusterConsoleButton" Command="{Binding OpenClusterConsoleCommand}"
                ToolTip.Tip="Средства администрирования: инструменты и консоль кластера серверов 1С">
          <c:ToolIcon Brush="{DynamicResource IconClusterBrush}" Data="{StaticResource ClusterIconGeometry}" />
        </Button>
        <!-- Тема по кругу: как в системе → светлая → тёмная; значок — текущая тема. -->
        <Button x:Name="ThemeButton" Command="{Binding CycleThemeCommand}"
                ToolTip.Tip="{Binding ThemeToolTip}">
          <Panel Classes="toolbarGlyph">
            <!-- Как в системе: круг, закрашенный наполовину. -->
            <c:ToolIcon IsVisible="{Binding IsSystemTheme}" Brush="{DynamicResource IconAutoThemeBrush}"
                        Data="M 8,1.5 A 6.5,6.5 0 1 1 7.99,1.5 Z" SolidData="M 8,1.5 A 6.5,6.5 0 0 0 8,14.5 Z" />
            <!-- Светлая: солнце. -->
            <c:ToolIcon IsVisible="{Binding IsLightTheme}" Brush="{DynamicResource IconLightThemeBrush}"
                        Data="M 8,5 A 3,3 0 1 1 7.99,5 Z M 8,0.5 L 8,2.5 M 8,13.5 L 8,15.5 M 0.5,8 L 2.5,8 M 13.5,8 L 15.5,8 M 2.7,2.7 L 4.1,4.1 M 11.9,11.9 L 13.3,13.3 M 2.7,13.3 L 4.1,11.9 M 11.9,4.1 L 13.3,2.7" />
            <!-- Тёмная: месяц. -->
            <c:ToolIcon IsVisible="{Binding IsDarkTheme}" Brush="{DynamicResource IconDarkThemeBrush}"
                        Data="M 10,1.8 A 6.5,6.5 0 1 0 14.2,10.5 A 5.2,5.2 0 0 1 10,1.8 Z" />
          </Panel>
        </Button>
        <Button x:Name="SettingsButton" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Настройки">
          <!-- Шестерёнка: кольцо, ось и восемь зубцов (зубцы — толстыми короткими штрихами). -->
          <c:ToolIcon Brush="{DynamicResource IconSettingsBrush}"
                      Data="M 8,3.5 A 4.5,4.5 0 1 1 7.99,3.5 Z M 8,6.2 A 1.8,1.8 0 1 1 7.99,6.2 Z"
                      BoldData="M 12.5,8 L 14.8,8 M 11.18,11.18 L 12.81,12.81 M 8,12.5 L 8,14.8 M 4.82,11.18 L 3.19,12.81 M 3.5,8 L 1.2,8 M 4.82,4.82 L 3.19,3.19 M 8,3.5 L 8,1.2 M 11.18,4.82 L 12.81,3.19" />
        </Button>
      </StackPanel>
      </Panel>

      <TextBox x:Name="SearchBox" HorizontalAlignment="Right"
               Text="{Binding SearchText}"
               PlaceholderText="{Binding HotKeys.FocusSearchSuffix, StringFormat='Поиск: имя, сервер, путь{0}'}"
               ToolTip.Tip="Поиск по имени, серверу и пути; можно набирать в любой раскладке">
        <TextBox.InnerRightContent>
          <Button Classes="bare" Content="✕" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearch}"
                  Background="Transparent" Padding="8,0" ToolTip.Tip="Очистить (Esc, Ctrl+Q)" />
        </TextBox.InnerRightContent>
      </TextBox>
    </DockPanel>

    <!-- Низ: строка состояния и диагностика. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button Padding="8,2" FontSize="{StaticResource SmallFontSize}" Content="{Binding CacheSummaryText}" Command="{Binding OpenCacheManagerCommand}"
                  IsVisible="{Binding CacheSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Кэш всех баз: размеры, кэш без хозяина, очистка" />
          <ToggleButton x:Name="PlatformsToggle" Padding="8,2" FontSize="{StaticResource SmallFontSize}">
            <TextBlock>
              <Run Text="Платформы: " /><Run Text="{Binding PlatformCount}" />
            </TextBlock>
          </ToggleButton>
          <TextBlock FontSize="{StaticResource SmallFontSize}" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding HasUnavailable}"
                     ToolTip.Tip="Базы, которые не ответили при проверке, отмечены ⚠">
            <Run Text="⚠ недоступно: " /><Run Text="{Binding UnavailableCount}" />
          </TextBlock>
          <ToggleButton x:Name="WarningsToggle" Padding="8,2" FontSize="{StaticResource SmallFontSize}" IsVisible="{Binding HasWarnings}">
            <TextBlock>
              <Run Text="Предупреждения: " /><Run Text="{Binding WarningCount}" />
            </TextBlock>
          </ToggleButton>
          <!-- Значок «окно с правой панелью»: панель закрашена, когда подробности показаны. -->
          <ToggleButton x:Name="DetailsToggle" IsChecked="{Binding ShowDetails}" Padding="6,3" VerticalAlignment="Stretch"
                        ToolTip.Tip="Показать или скрыть свойства информационной базы">
            <Panel Width="16" Height="14">
              <Path Data="M 10,1.5 L 14.5,1.5 L 14.5,12.5 L 10,12.5 Z" Fill="{Binding $parent[ToggleButton].Foreground}"
                    IsVisible="{Binding ShowDetails}" />
              <Path Data="M 1.5,1.5 L 14.5,1.5 L 14.5,12.5 L 1.5,12.5 Z M 10,1.5 L 10,12.5"
                    Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.3" />
            </Panel>
          </ToggleButton>
        </StackPanel>
        <!-- Слева: адрес выделенной базы, за ним — копирование строки подключения; дальше — сообщения. -->
        <StackPanel x:Name="StatusAddressPanel" DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0"
                    IsVisible="{Binding HasSelection}">
          <TextBlock x:Name="StatusAddressText" Text="{Binding SelectedInfoBase.ConnectionText, FallbackValue=''}" VerticalAlignment="Center"
                     MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding SelectedInfoBase.ConnectionString, FallbackValue=''}" />
          <Button x:Name="StatusCopyConnectionButton" Classes="statusIcon" Command="{Binding CopyConnectionStringCommand}"
                  ToolTip.Tip="Копировать строку подключения">
            <c:ToolIcon Width="16" Height="16" Brush="{DynamicResource IconCopyBrush}"
                        Data="M 5,1.5 L 13.5,1.5 L 13.5,11 L 5,11 Z M 2.5,4.5 L 2.5,14 L 10.5,14" />
          </Button>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" IsVisible="{Binding #PlatformsToggle.IsChecked}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer MaxHeight="160">
        <SelectableTextBlock Text="{Binding PlatformsText}" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="{StaticResource SmallFontSize}" />
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" IsVisible="{Binding #WarningsToggle.IsChecked}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer MaxHeight="160">
        <SelectableTextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" FontSize="{StaticResource SmallFontSize}" />
      </ScrollViewer>
    </Border>

    <!-- Список баз, разделитель и панель подробностей. Ширину колонки панели задаёт код (MainWindow.axaml.cs). -->
    <Grid x:Name="BodyGrid" ColumnDefinitions="*,Auto,340">
    <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent"
                  ToolTip.Tip="Потяните, чтобы изменить ширину правой панели" />

    <!-- Справа: кнопки запуска видны всегда, под ними — свойства выбранной базы (скрываются кнопкой в строке состояния). -->
    <Border x:Name="DetailsBorder" Grid.Column="2" Padding="12,4,12,8"
            BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
        <DockPanel>
          <!-- Запуск — над свойствами: кнопки одна под другой, у каждой справа прикреплена «Запустить с параметрами».
               Ширина постоянная, прижаты к левой границе панели: при расширении панели кнопки не растут. -->
          <StackPanel x:Name="LaunchButtons" DockPanel.Dock="Top" Spacing="6" Margin="0,4,0,12" Width="220" HorizontalAlignment="Left"
                      IsVisible="{Binding ShowSideLaunchButtons}">
            <Grid ColumnDefinitions="*,Auto">
              <Button x:Name="LaunchEnterpriseButton" Classes="accent launchMain" Command="{Binding LaunchEnterpriseCommand}"
                      ToolTip.Tip="F3, Enter или двойной щелчок">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:ToolIcon Classes="buttonIcon" Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" />
                  <TextBlock Text="1С: Предприятие" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="EnterpriseParametersButton" Grid.Column="1" Classes="accent launchParameters"
                      Command="{Binding LaunchEnterpriseWithParametersCommand}" ToolTip.Tip="1С: Предприятие с параметрами">
                <c:ToolIcon Classes="buttonIcon" Data="{StaticResource ParametersIconGeometry}" SolidData="{StaticResource ParametersKnobsIconGeometry}" />
              </Button>
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
              <Button x:Name="LaunchDesignerButton" Classes="launchMain" Command="{Binding LaunchDesignerCommand}" ToolTip.Tip="F4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <c:ToolIcon Classes="buttonIcon" Data="{StaticResource DesignerIconGeometry}" />
                  <TextBlock Text="Конфигуратор" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button x:Name="DesignerParametersButton" Grid.Column="1" Classes="launchParameters"
                      Command="{Binding LaunchDesignerWithParametersCommand}" ToolTip.Tip="Конфигуратор с параметрами">
                <c:ToolIcon Classes="buttonIcon" Data="{StaticResource ParametersIconGeometry}" SolidData="{StaticResource ParametersKnobsIconGeometry}" />
              </Button>
            </Grid>
            <!-- Стандартный стартер 1С (1cestart) — со своим списком баз; не зависит от выбранной базы. -->
            <Button x:Name="LaunchStarterButton" Classes="launchMain single" Command="{Binding LaunchStarterCommand}"
                    ToolTip.Tip="Запустить стандартный стартер 1С (1cestart)">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:ToolIcon Classes="buttonIcon" Data="{StaticResource StarterIconGeometry}" />
                <TextBlock Text="Стартер 1С" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock x:Name="PropertiesHeader" DockPanel.Dock="Top" Classes="sectionHeader" Text="Свойства информационной базы"
                     IsVisible="{Binding ShowDetails}" />
        <Panel x:Name="PropertiesPanel" IsVisible="{Binding ShowDetails}">
        <TextBlock Text="Выберите базу" Opacity="0.6" IsVisible="{Binding !HasSelection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding HasSelection}" HorizontalScrollBarVisibility="Disabled">
          <!-- Справа — место под полосу прокрутки: в теме Fluent она рисуется поверх содержимого. -->
          <StackPanel Spacing="10" Margin="0,0,12,0">
            <DockPanel>
              <Button x:Name="FavoriteButton" DockPanel.Dock="Right" Command="{Binding ToggleFavoriteCommand}" Padding="8,4"
                      VerticalAlignment="Top" ToolTip.Tip="{Binding HotKeys.ToggleFavoriteSuffix, StringFormat='Избранное{0}'}">
                <!-- Звезда: закрашенная — база в избранном, контур — нет. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Panel VerticalAlignment="Center">
                    <c:ToolIcon Classes="favStar" SolidData="{StaticResource StarIconGeometry}"
                                IsVisible="{Binding SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                    <c:ToolIcon Classes="favStar" IsVisible="{Binding !SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                  </Panel>
                  <Panel VerticalAlignment="Center">
                    <TextBlock Text="В избранном" IsVisible="{Binding SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                    <TextBlock Text="В избранное" IsVisible="{Binding !SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                  </Panel>
                </StackPanel>
              </Button>
              <SelectableTextBlock Text="{Binding SelectedInfoBase.Name}" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
            </DockPanel>

            <!-- Свойства тремя группами: как запускается; откуда база в списке; состояние и история. -->
            <Grid x:Name="PropertiesGrid" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="Тип" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ConnectionKindText}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Клиент" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ClientText}" />
              <TextBlock Grid.Row="2" Classes="label" Text="Платформа" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.PlatformText}"
                                   ToolTip.Tip="{Binding SelectedInfoBase.PlatformToolTip}" />
              <TextBlock Grid.Row="3" Classes="label" Text="Параметры" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LaunchParametersText}" />
              <TextBlock Grid.Row="4" Classes="label" Text="Пользователь" />
              <SelectableTextBlock Grid.Row="4" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.UserText}" />
              <TextBlock Grid.Row="5" Classes="label" Text="Подключение" />
              <DockPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="2,-3,0,0">
                  <Button x:Name="CopyConnectionButton" Classes="icon" Command="{Binding CopyConnectionStringCommand}"
                          ToolTip.Tip="Копировать строку подключения">
                    <!-- Два листа. -->
                    <c:ToolIcon Brush="{DynamicResource IconCopyBrush}" Data="M 5,1.5 L 13.5,1.5 L 13.5,11 L 5,11 Z M 2.5,4.5 L 2.5,14 L 10.5,14" />
                  </Button>
                  <Button x:Name="OpenBaseFolderButton" Classes="icon" Command="{Binding OpenBaseFolderCommand}"
                          IsVisible="{Binding SelectedInfoBase.IsFileBase, FallbackValue=False}"
                          ToolTip.Tip="Открыть каталог базы">
                    <!-- Папка. -->
                    <c:ToolIcon Brush="{DynamicResource IconFolderBrush}" Data="M 1.5,3 L 6,3 L 7.5,4.5 L 14.5,4.5 L 14.5,13.5 L 1.5,13.5 Z M 1.5,6.5 L 14.5,6.5" />
                  </Button>
                </StackPanel>
                <SelectableTextBlock Text="{Binding SelectedInfoBase.ConnectionText}" TextWrapping="Wrap" />
              </DockPanel>

              <Border Grid.Row="6" Grid.ColumnSpan="2" Classes="propertiesSeparator" />
              <TextBlock Grid.Row="7" Classes="label" Text="Источник" />
              <SelectableTextBlock Grid.Row="7" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.SourceText}"
                                   ToolTip.Tip="{Binding SelectedInfoBase.SourceLocation}" />
              <TextBlock Grid.Row="8" Classes="label" Text="Группа" />
              <SelectableTextBlock Grid.Row="8" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.FolderText}" />

              <Border Grid.Row="9" Grid.ColumnSpan="2" Classes="propertiesSeparator" />
              <TextBlock Grid.Row="10" Classes="label" Text="Кэш" />
              <SelectableTextBlock Grid.Row="10" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.CacheText}" />
              <TextBlock Grid.Row="11" Classes="label" Text="Доступность" />
              <SelectableTextBlock Grid.Row="11" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.AvailabilityText}" />
              <TextBlock Grid.Row="12" Classes="label" Text="Последний запуск" />
              <SelectableTextBlock Grid.Row="12" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LastLaunchText}" />
              <TextBlock Grid.Row="13" Classes="label" Text="Запусков" />
              <SelectableTextBlock Grid.Row="13" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LaunchCount}" />
            </Grid>

            <WrapPanel>
              <Button Content="Параметры запуска…" Command="{Binding EditLaunchSettingsCommand}" Margin="0,0,6,6"
                      ToolTip.Tip="Параметры командной строки, пользователь и пароль — хранятся в лаунчере" />
              <Button Content="Очистить кэш" Command="{Binding ClearCacheCommand}" Margin="0,0,6,6"
                      ToolTip.Tip="Удалить кэш базы; 1С заполнит его заново при запуске" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
        </Panel>
        </DockPanel>
    </Border>

    <!-- Основное: дерево или список. Контекстное меню действует на выделенную базу. -->
    <DockPanel Grid.Column="0" Margin="8,4,8,8">
    <!-- Заголовки колонок. Колонки справа — фиксированной ширины и прижаты к правому краю строки,
         поэтому совпадают и в дереве, где вложенные базы сдвинуты вправо. -->
    <Border x:Name="ColumnHeadersBand" DockPanel.Dock="Top">
    <Grid x:Name="ColumnHeaders" ColumnDefinitions="*,Auto,Auto,Auto" Classes.tree="{Binding ShowTree}"
          Classes.twoLine="{Binding TwoLineRows}">
      <!-- В дереве заголовок переключает порядок: по наименованию (стрелка) или свой. -->
      <Button x:Name="SortByNameButton" Classes="columnHeader" Command="{Binding ToggleSortCommand}"
              IsHitTestVisible="{Binding ShowTree}" ToolTip.Tip="{Binding SortToolTip}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Text="Наименование" FontSize="{StaticResource SmallFontSize}" />
          <TextBlock Text="▲" FontSize="9" VerticalAlignment="Center">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="ShowTree" />
                <Binding Path="IsSortedByName" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
        </StackPanel>
      </Button>
      <TextBlock Grid.Column="1" Classes="columnHeader cell platform" Text="Платформа" />
      <TextBlock Grid.Column="2" Classes="columnHeader cell mode" Text="Режим запуска" />
      <TextBlock Grid.Column="3" Classes="columnHeader cell date" Text="Последний запуск" ToolTip.Tip="Дата последнего запуска из лаунчера" />
      <Border x:Name="PlatformColumnGrip" Grid.Column="1" Classes="columnGrip" Tag="{x:Static vm:ListColumn.Platform}"><Border /></Border>
      <Border x:Name="ModeColumnGrip" Grid.Column="2" Classes="columnGrip" Tag="{x:Static vm:ListColumn.Mode}"><Border /></Border>
      <Border x:Name="LastLaunchColumnGrip" Grid.Column="3" Classes="columnGrip" Tag="{x:Static vm:ListColumn.LastLaunch}"><Border /></Border>
    </Grid>
    </Border>

    <Panel>
      <Panel.ContextMenu>
        <ContextMenu>
          <MenuItem Header="1С: Предприятие" Command="{Binding LaunchEnterpriseCommand}" InputGesture="{Binding HotKeys.LaunchEnterprise}">
            <MenuItem.Icon><c:ToolIcon Classes="buttonIcon" Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Конфигуратор" Command="{Binding LaunchDesignerCommand}" InputGesture="{Binding HotKeys.LaunchDesigner}">
            <MenuItem.Icon><c:ToolIcon Classes="buttonIcon" Data="{StaticResource DesignerIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Запустить с параметрами…" Command="{Binding LaunchWithParametersCommand}" InputGesture="{Binding HotKeys.LaunchWithParameters}">
            <MenuItem.Icon><c:ToolIcon Classes="buttonIcon" Data="{StaticResource ParametersIconGeometry}" SolidData="{StaticResource ParametersKnobsIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Параметры запуска…" Command="{Binding EditLaunchSettingsCommand}" />
          <MenuItem Header="Очистить кэш и запустить" Command="{Binding ClearCacheAndLaunchCommand}" />
          <Separator />
          <MenuItem Header="Изменить…" Command="{Binding EditCommand}" InputGesture="{Binding HotKeys.Edit}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconSettingsBrush}" Data="{StaticResource EditIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Изменить как текст…" Command="{Binding EditAsTextCommand}" />
          <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGesture="{Binding HotKeys.Delete}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconDeleteBrush}" Data="{StaticResource DeleteIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Выше" Command="{Binding MoveUpCommand}" InputGesture="{Binding HotKeys.MoveUp}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconSettingsBrush}" Data="{StaticResource UpIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Ниже" Command="{Binding MoveDownCommand}" InputGesture="{Binding HotKeys.MoveDown}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconSettingsBrush}" Data="{StaticResource DownIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Упорядочить папку по наименованию" Command="{Binding SortFolderByNameCommand}"
                    ToolTip.Tip="Записи внутри выбранной папки (у базы — её папки) — по алфавиту, сначала папки. Порядок сохраняется в списке баз." />
          <MenuItem Header="Скопировать в личный список" Command="{Binding CopyToPersonalCommand}" />
          <Separator />
          <MenuItem Header="Новая база…" Command="{Binding AddBaseCommand}" InputGesture="{Binding HotKeys.AddBase}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconAddBrush}" Data="{StaticResource AddIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Новая папка…" Command="{Binding AddFolderCommand}" InputGesture="{Binding HotKeys.AddFolder}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconFolderBrush}" Data="{StaticResource FolderIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <Separator />
          <MenuItem Header="Избранное" Command="{Binding ToggleFavoriteCommand}" InputGesture="{Binding HotKeys.ToggleFavorite}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconFavoriteBrush}" Data="{StaticResource StarIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Копировать строку подключения" Command="{Binding CopyConnectionStringCommand}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconCopyBrush}" Data="{StaticResource CopyIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Открыть каталог базы" Command="{Binding OpenBaseFolderCommand}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconFolderBrush}" Data="{StaticResource FolderIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <MenuItem Header="Очистить кэш" Command="{Binding ClearCacheCommand}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconDeleteBrush}" Data="{StaticResource CacheIconGeometry}" /></MenuItem.Icon>
          </MenuItem>
          <!-- Каталоги кэша — подменю; недоступно, если у базы кэша нет. -->
          <MenuItem x:Name="OpenCacheMenu" Header="Открыть каталог кэша" IsEnabled="{Binding SelectedInfoBase.HasCache, FallbackValue=False}">
            <MenuItem.Icon><c:ToolIcon Classes="menuIcon" Brush="{DynamicResource IconFolderBrush}" Data="{StaticResource FolderIconGeometry}" /></MenuItem.Icon>
            <MenuItem Header="Программный кэш" Command="{Binding OpenLocalCacheCommand}" />
            <MenuItem Header="Пользовательский кэш" Command="{Binding OpenRoamingCacheCommand}" />
          </MenuItem>
          <MenuItem Header="Сохранить ссылку в файл…" Command="{Binding ExportCommand}" />
        </ContextMenu>
      </Panel.ContextMenu>

      <TreeView x:Name="CatalogTree"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                DragDrop.AllowDrop="True"
                ItemsSource="{Binding TreeItems}"
                SelectedItem="{Binding SelectedTreeItem}"
                IsVisible="{Binding ShowTree}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
          <!-- Строка на всю ширину, чтобы колонки прижались к правому краю. -->
          <Style Selector="TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <!-- Значок папки: обычная — папка, «Избранное» — звезда. -->
              <Panel Width="18" Height="18" VerticalAlignment="Center">
                <c:ToolIcon IsVisible="{Binding IsRegularFolder}" Brush="{DynamicResource IconFolderBrush}"
                            Data="M 1.5,3 L 6,3 L 7.5,4.5 L 14.5,4.5 L 14.5,13.5 L 1.5,13.5 Z M 1.5,6.5 L 14.5,6.5" />
                <c:ToolIcon IsVisible="{Binding IsFavorites}" Classes="favStar" Width="18" Height="18" />
              </Panel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </StackPanel>
          </TreeDataTemplate>
          <DataTemplate DataType="vm:BaseNodeViewModel">
            <Grid Classes="baseRow" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Background="Transparent"
                  Classes.twoLine="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TwoLineRows}"
                  Classes.launchLeft="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRowLaunchLeft}">
              <!-- DockPanel, а не StackPanel: имя получает оставшуюся ширину и обрезается, не наезжая на колонки. -->
              <DockPanel>
                <!-- Кнопки запуска — в колонке наименования, у её правого края; имя обрезается перед ними. -->
                <Panel Classes="rowLaunchCell"
                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRowLaunchButtons}">
                  <StackPanel Classes="rowLaunch" Orientation="Horizontal" Spacing="2">
                    <Button Classes="rowLaunch enterprise" ToolTip.Tip="1С: Предприятие"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchEnterpriseCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" />
                    </Button>
                    <Button Classes="rowLaunch designer" ToolTip.Tip="Конфигуратор"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchDesignerCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource DesignerIconGeometry}" />
                    </Button>
                    <Button Classes="rowLaunch parameters" ToolTip.Tip="Запустить с параметрами"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchWithParametersCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource ParametersIconGeometry}" SolidData="{StaticResource ParametersKnobsIconGeometry}" />
                    </Button>
                  </StackPanel>
                  <Button Classes="rowLaunch enterprise rowLaunchMenu" Tag="{Binding Base}" ToolTip.Tip="Запустить…">
                    <c:ToolIcon Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" />
                  </Button>
                </Panel>
                <c:ToolIcon DockPanel.Dock="Left" Classes="favStar" IsVisible="{Binding Base.IsFavorite}" Margin="0,0,8,0" />
                <TextBlock DockPanel.Dock="Left" Text="⚠" IsVisible="{Binding Base.IsUnavailable}" ToolTip.Tip="{Binding Base.AvailabilityText}"
                           Foreground="#C57C00" Margin="0,0,8,0" />
                <Grid DockPanel.Dock="Left" Classes="nameWithDot" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Base.NameToolTip}" />
                  <Ellipse Grid.Column="1" Classes="runningDot" IsVisible="{Binding Base.IsRunning}" ToolTip.Tip="{Binding Base.RunningToolTip}" />
                </Grid>
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="общий" IsVisible="{Binding Base.InfoBase.IsReadOnly}" VerticalAlignment="Center"
                           Margin="0,0,8,0" ToolTip.Tip="Из общего списка: изменить можно только копию в личном списке" />
                <TextBlock DockPanel.Dock="Left" Classes="secondary" Text="копия" IsVisible="{Binding Base.IsFromCache}" VerticalAlignment="Center"
                           Margin="0,0,8,0" ToolTip.Tip="{Binding Base.SourceText}" />
              </DockPanel>
              <TextBlock Grid.Column="1" Classes="cell platform" Text="{Binding Base.PlatformText}" ToolTip.Tip="{Binding Base.PlatformToolTip}"
                         Classes.missing="{Binding Base.IsPlatformMissing}" />
              <TextBlock Grid.Column="2" Classes="cell mode" Text="{Binding Base.ClientShortText}" />
              <TextBlock Grid.Column="3" Classes="cell date" Text="{Binding Base.LastLaunchShortText}" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Classes="rowDetails">
                <TextBlock Classes="secondary" Text="{Binding Base.PlatformText}" ToolTip.Tip="{Binding Base.PlatformToolTip}"
                           Classes.missing="{Binding Base.IsPlatformMissing}" />
                <TextBlock Classes="secondary" Text="{Binding Base.ClientShortText, StringFormat='·  {0}'}" ToolTip.Tip="Режим запуска" />
                <TextBlock Classes="secondary" Text="{Binding Base.LastLaunchShortText, StringFormat='·  запуск {0}'}" ToolTip.Tip="Последний запуск из лаунчера"
                           IsVisible="{Binding Base.LastLaunchShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <ListBox x:Name="CatalogList"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ItemsSource="{Binding ListItems}"
               SelectedItem="{Binding SelectedListItem}"
               IsVisible="{Binding ShowList}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:BaseListItemViewModel">
            <Grid Classes="baseRow" ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Background="Transparent"
                  Classes.twoLine="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TwoLineRows}"
                  Classes.launchLeft="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsRowLaunchLeft}">
              <!-- Одна строка: имя и папка; путь к базе — в подсказке к имени (поиск по нему работает). -->
              <DockPanel VerticalAlignment="Center">
                <!-- Кнопки запуска — в колонке наименования, у её правого края; имя обрезается перед ними. -->
                <Panel Classes="rowLaunchCell"
                       IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRowLaunchButtons}">
                  <StackPanel Classes="rowLaunch" Orientation="Horizontal" Spacing="2">
                    <Button Classes="rowLaunch enterprise" ToolTip.Tip="1С: Предприятие"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchEnterpriseCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" />
                    </Button>
                    <Button Classes="rowLaunch designer" ToolTip.Tip="Конфигуратор"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchDesignerCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource DesignerIconGeometry}" />
                    </Button>
                    <Button Classes="rowLaunch parameters" ToolTip.Tip="Запустить с параметрами"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchWithParametersCommand}" CommandParameter="{Binding Base}">
                      <c:ToolIcon Data="{StaticResource ParametersIconGeometry}" SolidData="{StaticResource ParametersKnobsIconGeometry}" />
                    </Button>
                  </StackPanel>
                  <Button Classes="rowLaunch enterprise rowLaunchMenu" Tag="{Binding Base}" ToolTip.Tip="Запустить…">
                    <c:ToolIcon Data="{StaticResource EnterpriseIconGeometry}" SolidData="{StaticResource EnterpriseIconGeometry}" />
                  </Button>
                </Panel>
                <c:ToolIcon DockPanel.Dock="Left" Classes="favStar" IsVisible="{Binding Base.IsFavorite}" Margin="0,0,6,0" />
                <TextBlock DockPanel.Dock="Left" Text="⚠" IsVisible="{Binding Base.IsUnavailable}" ToolTip.Tip="{Binding Base.AvailabilityText}"
                           Foreground="#C57C00" Margin="0,0,6,0" />
                <Grid DockPanel.Dock="Left" Classes="nameWithDot" ColumnDefinitions="*,Auto">
                  <c:HighlightTextBlock Segments="{Binding NameSegments}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Base.NameToolTip}" />
                  <Ellipse Grid.Column="1" Classes="runningDot" IsVisible="{Binding Base.IsRunning}" ToolTip.Tip="{Binding Base.RunningToolTip}" />
                </Grid>
                <TextBlock Classes="secondary" Text="{Binding Base.RowFolderText}" IsVisible="{Binding Base.HasRowFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Grid.Column="1" Classes="cell platform" Text="{Binding Base.PlatformText}" ToolTip.Tip="{Binding Base.PlatformToolTip}"
                         Classes.missing="{Binding Base.IsPlatformMissing}" />
              <TextBlock Grid.Column="2" Classes="cell mode" Text="{Binding Base.ClientShortText}" />
              <TextBlock Grid.Column="3" Classes="cell date" Text="{Binding Base.LastLaunchShortText}" />
              <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Classes="rowDetails">
                <TextBlock Classes="secondary" Text="{Binding Base.PlatformText}" ToolTip.Tip="{Binding Base.PlatformToolTip}"
                           Classes.missing="{Binding Base.IsPlatformMissing}" />
                <TextBlock Classes="secondary" Text="{Binding Base.ClientShortText, StringFormat='·  {0}'}" ToolTip.Tip="Режим запуска" />
                <TextBlock Classes="secondary" Text="{Binding Base.LastLaunchShortText, StringFormat='·  запуск {0}'}" ToolTip.Tip="Последний запуск из лаунчера"
                           IsVisible="{Binding Base.LastLaunchShortText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="{Binding EmptyListText}" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowNothingFound}" IsHitTestVisible="False" />
    </Panel>
    </DockPanel>
    </Grid>
  </DockPanel>
</Window>
