<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        x:Class="YetAnotherOneCLauncher.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="YetAnotherOneCLauncher"
        Width="1040" Height="660"
        MinWidth="560" MinHeight="360">

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Margin" Value="0,0,12,6" />
    </Style>
    <Style Selector="SelectableTextBlock.value">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.secondary">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Верх: поиск, вид, обновление, настройки. -->
    <DockPanel DockPanel.Dock="Top" Margin="8,8,8,4" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
        <ToggleButton IsChecked="{Binding IsTreeMode}"
                      ToolTip.Tip="Дерево папок или плоский список">
          <Panel>
            <TextBlock Text="Дерево" IsVisible="{Binding IsTreeMode}" />
            <TextBlock Text="Список" IsVisible="{Binding !IsTreeMode}" />
          </Panel>
        </ToggleButton>
        <Button Content="＋" ToolTip.Tip="Добавить" IsEnabled="{Binding CanEditList}">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuItem Header="Новая база…" Command="{Binding AddBaseCommand}" InputGesture="Ctrl+N" />
              <MenuItem Header="Новая папка…" Command="{Binding AddFolderCommand}" InputGesture="Ctrl+Shift+N" />
              <Separator />
              <MenuItem Header="Загрузить из файла .v8i…" Command="{Binding ImportCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <Button Content="Обновить" Command="{Binding ReloadCommand}" ToolTip.Tip="Перечитать списки баз и платформы (F5)" />
        <Button Content="⚙" ToolTip.Tip="Настройки">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight">
              <StackPanel Spacing="6" Width="300">
                <TextBlock Text="Тема" />
                <ComboBox ItemsSource="{Binding ThemeNames}" SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch" />
                <TextBlock Text="После запуска базы" Margin="0,6,0,0" />
                <ComboBox ItemsSource="{Binding AfterLaunchNames}" SelectedIndex="{Binding AfterLaunchIndex}" HorizontalAlignment="Stretch" />
                <CheckBox IsChecked="{Binding UseThickClientForFileBases}" Margin="0,6,0,0">
                  <TextBlock TextWrapping="Wrap" Text="Файловые базы с клиентом «Автоматически» открывать в толстом клиенте" />
                </CheckBox>
                <CheckBox IsChecked="{Binding ShowDetails}" Content="Панель подробностей" />
                <CheckBox IsChecked="{Binding CheckAvailability}">
                  <TextBlock TextWrapping="Wrap" Text="Проверять доступность баз: каталог файловой базы, сервер 1С, веб-сервер" />
                </CheckBox>
                <Button Content="Свои шаблоны параметров…" Command="{Binding EditParameterTemplatesCommand}" Margin="0,6,0,0" />
                <Button Content="Кэш баз…" Command="{Binding OpenCacheManagerCommand}" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>

      <TextBox x:Name="SearchBox"
               Text="{Binding SearchText}"
               PlaceholderText="Поиск: имя, сервер, путь — можно в любой раскладке (Ctrl+F)">
        <TextBox.InnerRightContent>
          <Button Content="✕" Command="{Binding ClearSearchCommand}" IsVisible="{Binding HasSearch}"
                  Background="Transparent" Padding="8,0" ToolTip.Tip="Очистить (Esc)" />
        </TextBox.InnerRightContent>
      </TextBox>
    </DockPanel>

    <!-- Низ: строка состояния и диагностика. -->
    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
          <Button Padding="8,2" FontSize="12" Content="{Binding CacheSummaryText}" Command="{Binding OpenCacheManagerCommand}"
                  IsVisible="{Binding CacheSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                  ToolTip.Tip="Кэш всех баз: размеры, кэш без хозяина, очистка" />
          <ToggleButton x:Name="PlatformsToggle" Padding="8,2" FontSize="12">
            <TextBlock>
              <Run Text="Платформы: " /><Run Text="{Binding PlatformCount}" />
            </TextBlock>
          </ToggleButton>
          <TextBlock FontSize="12" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding HasUnavailable}"
                     ToolTip.Tip="Базы, которые не ответили при проверке, отмечены ⚠">
            <Run Text="⚠ недоступно: " /><Run Text="{Binding UnavailableCount}" />
          </TextBlock>
          <ToggleButton x:Name="WarningsToggle" Padding="8,2" FontSize="12" IsVisible="{Binding HasWarnings}">
            <TextBlock>
              <Run Text="Предупреждения: " /><Run Text="{Binding WarningCount}" />
            </TextBlock>
          </ToggleButton>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" IsVisible="{Binding #PlatformsToggle.IsChecked}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer MaxHeight="160">
        <SelectableTextBlock Text="{Binding PlatformsText}" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="12" />
      </ScrollViewer>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8" IsVisible="{Binding #WarningsToggle.IsChecked}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <ScrollViewer MaxHeight="160">
        <SelectableTextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" FontSize="12" />
      </ScrollViewer>
    </Border>

    <!-- Справа: подробности выбранной базы. -->
    <Border DockPanel.Dock="Right" Width="340" IsVisible="{Binding ShowDetails}" Padding="12,4,12,8"
            BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <Panel>
        <TextBlock Text="Выберите базу" Opacity="0.6" IsVisible="{Binding !HasSelection}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ScrollViewer IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Command="{Binding ToggleFavoriteCommand}" Padding="8,4"
                      VerticalAlignment="Top" ToolTip.Tip="Избранное (Ctrl+D)">
                <Panel>
                  <TextBlock Text="★ В избранном" IsVisible="{Binding SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                  <TextBlock Text="☆ В избранное" IsVisible="{Binding !SelectedInfoBase.IsFavorite, FallbackValue=False}" />
                </Panel>
              </Button>
              <SelectableTextBlock Text="{Binding SelectedInfoBase.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="accent" Content="Предприятие" Command="{Binding LaunchEnterpriseCommand}" ToolTip.Tip="Enter или двойной щелчок" />
              <Button Content="Конфигуратор" Command="{Binding LaunchDesignerCommand}" ToolTip.Tip="Ctrl+Enter" />
              <Button Content="…" Command="{Binding LaunchWithParametersCommand}" ToolTip.Tip="Запустить с параметрами (Ctrl+Shift+Enter)" />
            </StackPanel>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Classes="label" Text="Подключение" />
              <SelectableTextBlock Grid.Row="0" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ConnectionText}" />
              <TextBlock Grid.Row="1" Classes="label" Text="Тип" />
              <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ConnectionKindText}" />
              <TextBlock Grid.Row="2" Classes="label" Text="Клиент" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ClientText}" />
              <TextBlock Grid.Row="3" Classes="label" Text="Версия в списке" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.ListVersionText}" />
              <TextBlock Grid.Row="4" Classes="label" Text="Платформа" VerticalAlignment="Center" />
              <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding PlatformChoices}" SelectedItem="{Binding SelectedPlatformChoice}"
                        ToolTip.Tip="Версия для запуска из лаунчера; список баз не меняется" />
              <TextBlock Grid.Row="9" Classes="label" Text="Параметры" />
              <SelectableTextBlock Grid.Row="9" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LaunchParametersText}" />
              <TextBlock Grid.Row="12" Classes="label" Text="Доступность" />
              <SelectableTextBlock Grid.Row="12" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.AvailabilityText}" />
              <TextBlock Grid.Row="11" Classes="label" Text="Кэш" />
              <SelectableTextBlock Grid.Row="11" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.CacheText}" />
              <TextBlock Grid.Row="10" Classes="label" Text="Пользователь" />
              <SelectableTextBlock Grid.Row="10" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.UserText}" />
              <TextBlock Grid.Row="5" Classes="label" Text="Папка" />
              <SelectableTextBlock Grid.Row="5" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.FolderText}" />
              <TextBlock Grid.Row="6" Classes="label" Text="Последний запуск" />
              <SelectableTextBlock Grid.Row="6" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LastLaunchText}" />
              <TextBlock Grid.Row="7" Classes="label" Text="Запусков" />
              <SelectableTextBlock Grid.Row="7" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.LaunchCount}" />
              <TextBlock Grid.Row="8" Classes="label" Text="Источник" />
              <SelectableTextBlock Grid.Row="8" Grid.Column="1" Classes="value" Text="{Binding SelectedInfoBase.SourceText}"
                                   ToolTip.Tip="{Binding SelectedInfoBase.SourceLocation}" />
            </Grid>

            <WrapPanel>
              <Button Content="Параметры запуска…" Command="{Binding EditLaunchSettingsCommand}" Margin="0,0,6,6"
                      ToolTip.Tip="Параметры командной строки, пользователь и пароль — хранятся в лаунчере" />
              <Button Content="Очистить кэш" Command="{Binding ClearCacheCommand}" Margin="0,0,6,6"
                      ToolTip.Tip="Удалить кэш базы (в корзину); 1С заполнит его заново при запуске" />
              <Button Content="Копировать строку подключения" Command="{Binding CopyConnectionStringCommand}" Margin="0,0,6,6" />
              <Button Content="Открыть каталог базы" Command="{Binding OpenBaseFolderCommand}" Margin="0,0,6,6"
                      IsVisible="{Binding SelectedInfoBase.IsFileBase, FallbackValue=False}" />
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Panel>
    </Border>

    <!-- Основное: дерево или список. Контекстное меню действует на выделенную базу. -->
    <Panel Margin="8,4,8,8">
      <Panel.ContextMenu>
        <ContextMenu>
          <MenuItem Header="Предприятие" Command="{Binding LaunchEnterpriseCommand}" InputGesture="Enter" />
          <MenuItem Header="Конфигуратор" Command="{Binding LaunchDesignerCommand}" InputGesture="Ctrl+Enter" />
          <MenuItem Header="Запустить с параметрами…" Command="{Binding LaunchWithParametersCommand}" InputGesture="Ctrl+Shift+Enter" />
          <MenuItem Header="Параметры запуска…" Command="{Binding EditLaunchSettingsCommand}" />
          <MenuItem Header="Очистить кэш и запустить" Command="{Binding ClearCacheAndLaunchCommand}" />
          <Separator />
          <MenuItem Header="Изменить…" Command="{Binding EditCommand}" InputGesture="F2" />
          <MenuItem Header="Изменить как текст…" Command="{Binding EditAsTextCommand}" />
          <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" InputGesture="Delete" />
          <MenuItem Header="Выше" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
          <MenuItem Header="Ниже" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
          <MenuItem Header="Скопировать в личный список" Command="{Binding CopyToPersonalCommand}" />
          <Separator />
          <MenuItem Header="Новая база…" Command="{Binding AddBaseCommand}" InputGesture="Ctrl+N" />
          <MenuItem Header="Новая папка…" Command="{Binding AddFolderCommand}" InputGesture="Ctrl+Shift+N" />
          <Separator />
          <MenuItem Header="Избранное" Command="{Binding ToggleFavoriteCommand}" InputGesture="Ctrl+D" />
          <MenuItem Header="Копировать строку подключения" Command="{Binding CopyConnectionStringCommand}" />
          <MenuItem Header="Открыть каталог базы" Command="{Binding OpenBaseFolderCommand}" />
          <MenuItem Header="Очистить кэш" Command="{Binding ClearCacheCommand}" />
          <MenuItem Header="Выгрузить в файл…" Command="{Binding ExportCommand}" />
          <MenuItem Header="Загрузить из файла…" Command="{Binding ImportCommand}" />
        </ContextMenu>
      </Panel.ContextMenu>

      <TreeView x:Name="CatalogTree"
                DragDrop.AllowDrop="True"
                ItemsSource="{Binding TreeItems}"
                SelectedItem="{Binding SelectedTreeItem}"
                IsVisible="{Binding ShowTree}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:TreeNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Icon}" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </StackPanel>
          </TreeDataTemplate>
          <DataTemplate DataType="vm:BaseNodeViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
              <TextBlock Text="★" IsVisible="{Binding Base.IsFavorite}" />
              <TextBlock Text="⚠" IsVisible="{Binding Base.IsUnavailable}" ToolTip.Tip="{Binding Base.AvailabilityText}" Foreground="#C57C00" />
              <TextBlock Text="{Binding Name}" />
              <TextBlock Classes="secondary" Text="общий" IsVisible="{Binding Base.InfoBase.IsReadOnly}" VerticalAlignment="Center"
                         ToolTip.Tip="Из общего списка: изменить можно только копию в личном списке" />
              <TextBlock Classes="secondary" Text="копия" IsVisible="{Binding Base.IsFromCache}" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding Base.SourceText}" />
              <TextBlock Classes="secondary" Text="{Binding Base.ConnectionText}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </TreeView.DataTemplates>
      </TreeView>

      <ListBox x:Name="CatalogList"
               ItemsSource="{Binding ListItems}"
               SelectedItem="{Binding SelectedListItem}"
               IsVisible="{Binding ShowList}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:BaseListItemViewModel">
            <StackPanel Spacing="2" Background="Transparent">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="★" IsVisible="{Binding Base.IsFavorite}" />
                <c:HighlightTextBlock Segments="{Binding NameSegments}" />
                <TextBlock Text="⚠" IsVisible="{Binding Base.IsUnavailable}" ToolTip.Tip="{Binding Base.AvailabilityText}" Foreground="#C57C00" />
              </StackPanel>
              <TextBlock Classes="secondary" Text="{Binding Base.Subtitle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Ничего не найдено" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding ShowNothingFound}" IsHitTestVisible="False" />
    </Panel>
  </DockPanel>
</Window>
