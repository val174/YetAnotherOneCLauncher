<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        xmlns:s="using:YetAnotherOneCLauncher.Core.Settings"
        x:Class="YetAnotherOneCLauncher.App.NewTagWindow"
        x:DataType="vm:NewTagViewModel"
        Title="Новая метка"
        Width="380" SizeToContent="Height" CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="6">
    <TextBlock Text="Наименование" />
    <TextBox x:Name="NameBox" Text="{Binding Name}" MaxLength="40" />

    <!-- Цвет — для новой метки; у имеющейся он свой (меняется в окне «Метки»). -->
    <StackPanel Spacing="2" Margin="0,6,0,0" IsVisible="{Binding !IsExisting}">
      <TextBlock Text="Цвет" />
      <ListBox x:Name="ColorList" ItemsSource="{x:Static vm:TagsEditorViewModel.Colors}"
               SelectedIndex="{Binding ColorIndex}" Background="Transparent">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="s:TagColor">
            <Ellipse Classes="tagSwatch" c:TagChip.Color="{Binding}" Width="16" Height="16" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>
    <TextBlock x:Name="ExistingText" IsVisible="{Binding IsExisting}" Opacity="0.7" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="Метка уже есть — будет поставлена с её цветом." />

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
      <TextBlock Text="Так будет выглядеть:" Opacity="0.7" VerticalAlignment="Center" />
      <Border x:Name="PreviewChip" Classes="tagChip" c:TagChip.Color="{Binding PreviewColor}">
        <TextBlock Text="{Binding PreviewName}" />
      </Border>
    </StackPanel>
    <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap" Text="{Binding TargetText}" />
    <TextBlock x:Name="ErrorText" Text="{Binding ErrorText}" IsVisible="{Binding HasError}" Foreground="#C42B1C" TextWrapping="Wrap" />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button x:Name="OkButton" Classes="accent" Content="Создать" IsDefault="True" MinWidth="100" />
      <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" MinWidth="100" />
    </StackPanel>
  </StackPanel>
</Window>
