<?xml version="1.0" encoding="utf-8"?>
<!--
  Один исполняемый файл для Linux x64, без установленного .NET:
    dotnet publish src/YetAnotherOneCLauncher.App -p:PublishProfile=linux-x64
  Результат — artifacts/publish/linux-x64/YetAnotherOneCLauncher.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Код заранее скомпилирован (ReadyToRun) — не компилируется при каждом старте; сборки внутри файла сжаты.
         Замер на Windows: ~63 МБ, окно через ~1,5 с (без ReadyToRun — ~2,1 с; без сжатия — ~0,9 с, но ~144 МБ). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\linux-x64\</PublishDir>
  </PropertyGroup>
</Project>
