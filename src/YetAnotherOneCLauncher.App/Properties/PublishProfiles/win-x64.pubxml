<?xml version="1.0" encoding="utf-8"?>
<!--
  Один исполняемый файл для Windows x64, без установленного .NET:
    dotnet publish src/YetAnotherOneCLauncher.App -p:PublishProfile=win-x64
  Результат — artifacts/publish/win-x64/YetAnotherOneCLauncher.exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Библиотеки отрисовки (Skia, HarfBuzz) — внутри файла; при первом запуске распаковываются во временный каталог. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Код заранее скомпилирован (ReadyToRun) — не компилируется при каждом старте; сборки внутри файла сжаты.
         Замер на Windows: ~63 МБ, окно через ~1,5 с (без ReadyToRun — ~2,1 с; без сжатия — ~0,9 с, но ~144 МБ). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Отладочные символы внутри файла: номера строк в логе при ошибке. -->
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
