<?xml version="1.0" encoding="utf-8"?>
<!--
  Один исполняемый файл для Windows x64, без установленного .NET:
    dotnet publish src/YetAnotherOneCLauncher.App -p:PublishProfile=win-x64
  Результат — artifacts/publish/win-x64/YetAnotherOneCLauncher.exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Библиотеки отрисовки (Skia, HarfBuzz) — внутри файла; при первом запуске распаковываются во временный каталог. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Скорость открытия важнее размера (замер на Windows: окно через ~0,9 с вместо ~2,1 с, файл ~144 МБ вместо ~48 МБ):
         код заранее скомпилирован (ReadyToRun) — не компилируется при каждом старте, сборки не сжаты — не распаковываются в память. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Отладочные символы внутри файла: номера строк в логе при ошибке. -->
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
