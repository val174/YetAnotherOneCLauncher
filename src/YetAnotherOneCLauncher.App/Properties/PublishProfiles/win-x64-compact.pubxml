<?xml version="1.0" encoding="utf-8"?>
<!--
  Компактный вариант для Windows x64 — меньше размер, дольше открытие:
    dotnet publish src/YetAnotherOneCLauncher.App -p:PublishProfile=win-x64-compact
  Результат — artifacts/publish/win-x64-compact/YetAnotherOneCLauncher.exe.
  Отличие от win-x64 — сборки внутри файла сжаты (замер на Windows: ~63 МБ вместо ~144 МБ; окно через ~1,5 с
  вместо ~0,9 с, первый запуск новой версии ~7,7 с вместо ~3,7 с).
-->
<Project>
  <Import Project="win-x64.pubxml" />
  <PropertyGroup>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\artifacts\publish\win-x64-compact\</PublishDir>
  </PropertyGroup>
</Project>
