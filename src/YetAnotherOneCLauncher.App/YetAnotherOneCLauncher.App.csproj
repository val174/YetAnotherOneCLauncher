<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>YetAnotherOneCLauncher.App</RootNamespace>
    <AssemblyName>YetAnotherOneCLauncher</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    Публикация одним файлом (Properties/PublishProfiles): отладочные символы не кладутся рядом с .exe.
    Свои — встроены в сборки (DebugType=embedded), символы нативных библиотек из пакетов (SkiaSharp и др.) не нужны.
  -->
  <Target Name="ExcludeSymbolsFromSingleFilePublish" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="YetAnotherOneCLauncher.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YetAnotherOneCLauncher.Core\YetAnotherOneCLauncher.Core.csproj" />
    <ProjectReference Include="..\YetAnotherOneCLauncher.Platform\YetAnotherOneCLauncher.Platform.csproj" />
  </ItemGroup>

</Project>
