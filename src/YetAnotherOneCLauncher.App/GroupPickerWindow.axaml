<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:YetAnotherOneCLauncher.App.ViewModels"
        xmlns:c="using:YetAnotherOneCLauncher.App.Controls"
        x:Class="YetAnotherOneCLauncher.App.GroupPickerWindow"
        x:DataType="vm:GroupPickerViewModel"
        Title="Выбор группы"
        Width="480" Height="460" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,10,0,0">
      <Border IsVisible="{Binding HasError}" Padding="8" CornerRadius="4" Background="#33E81123">
        <TextBlock x:Name="ErrorText" Text="{Binding Error}" TextWrapping="Wrap" />
      </Border>
      <DockPanel>
        <Button x:Name="CreateGroupButton" DockPanel.Dock="Left" Command="{Binding CreateGroupCommand}"
                ToolTip.Tip="Новая группа внутри выделенной; если выделено «Не выбрана» — в корне списка">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:ToolIcon Width="16" Height="16" Brush="{DynamicResource IconFolderBrush}"
                        Data="M 1.5,3 L 6,3 L 7.5,4.5 L 14.5,4.5 L 14.5,13.5 L 1.5,13.5 Z M 8,7.5 L 8,12 M 5.75,9.75 L 10.25,9.75" />
            <TextBlock Text="Создать группу…" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="OkButton" Classes="accent" Content="Выбрать" IsDefault="True" MinWidth="100" />
          <Button x:Name="CancelButton" Content="Отмена" IsCancel="True" MinWidth="100" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="Группа в списке информационных баз:" Margin="0,0,0,8" />
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="4">
      <TreeView x:Name="GroupsTree" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:GroupNodeViewModel">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:GroupNodeViewModel" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Panel Width="18" Height="18" VerticalAlignment="Center">
                <c:ToolIcon IsVisible="{Binding !IsNoGroup}" Brush="{DynamicResource IconFolderBrush}"
                            Data="{StaticResource FolderIconGeometry}" />
                <c:ToolIcon IsVisible="{Binding IsNoGroup}" Brush="{DynamicResource IconFolderBrush}" Opacity="0.6"
                            Data="M 1.5,3 L 6,3 L 7.5,4.5 L 14.5,4.5 L 14.5,13.5 L 1.5,13.5 Z" />
              </Panel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock IsVisible="{Binding IsNoGroup}" Text="— в корне списка" Opacity="0.6" VerticalAlignment="Center" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
    </Border>
  </DockPanel>
</Window>
